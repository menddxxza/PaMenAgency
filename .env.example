# Supabase (públicas, van en el bundle del cliente)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --------------------------------------------------------------------------
# Todo lo de abajo NUNCA va en este archivo ni en el bundle del cliente.
# Son secretos de las Edge Functions — se cargan con:
#   supabase secrets set NOMBRE=valor
# --------------------------------------------------------------------------

# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SITE_URL=https://tu-dominio.com

# Stripe (Developers → API keys / Webhooks en el dashboard de Stripe)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Price ID de cada plan (Products → tu producto → Pricing en Stripe)
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_AGENCIA=price_...

# n8n — webhook que envía el mensaje saliente por la API de WhatsApp Business.
# Lo usan tanto el panel (respuestas manuales) como la Edge Function
# send-appointment-reminders (recordatorios automáticos).
# N8N_OUTBOUND_WEBHOOK_URL=https://tu-n8n.com/webhook/whatsapp-outbound

# Anthropic — usada por la Edge Function generate-bot-reply para responder
# preguntas frecuentes automáticamente por WhatsApp.
# ANTHROPIC_API_KEY=sk-ant-...

# --------------------------------------------------------------------------
# Recordatorios automáticos: programa send-appointment-reminders desde
# Database → Cron Jobs del dashboard de Supabase (cada 15 min es razonable),
# invocando POST https://<project>.supabase.co/functions/v1/send-appointment-reminders
# con Authorization: Bearer <service_role_key>.
# --------------------------------------------------------------------------

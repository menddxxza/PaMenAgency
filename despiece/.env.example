# ── Supabase ────────────────────────────────────────────────
# Panel > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Salta RLS: nunca exponerla al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Cadena de conexión directa, solo para ./db/apply.sh
DATABASE_URL=

# ── Cloudflare R2 (GLB) ─────────────────────────────────────
# Egress 0 €: es la razón de usar R2 y no S3.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Dominio público del bucket (r2.dev o dominio propio). Si se deja vacío
# los GLB se sirven con URL firmada temporal en su lugar.
NEXT_PUBLIC_R2_PUBLIC_BASE=

# ── Admin ───────────────────────────────────────────────────
# Mientras no exista Supabase Auth (fase 2), /admin pide esta clave.
# Sin valor, /admin queda cerrado en producción.
ADMIN_TOKEN=

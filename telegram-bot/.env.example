# --------------------------------------------------------------------------
# Modelo local (Ollama) — gratis, corre en tu propia máquina, sin coste por
# token. Instala Ollama (https://ollama.com) y descarga un modelo pequeño:
#   ollama pull llama3.2
# --------------------------------------------------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --------------------------------------------------------------------------
# Supabase del proyecto Atiende (mismo proyecto que usa la app web).
# La service_role key NUNCA va en el frontend, pero aquí es correcto porque
# este bot corre en un servidor/máquina de confianza, no en el navegador.
# --------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --------------------------------------------------------------------------
# Bot de soporte (público): token gratuito que te da @BotFather en Telegram.
# --------------------------------------------------------------------------
SUPPORT_BOT_TOKEN=

# --------------------------------------------------------------------------
# Bot personal (privado): usa OTRO token distinto, creado con @BotFather.
# OWNER_CHAT_IDS: tu chat_id de Telegram (pregúntaselo a @userinfobot),
# separados por comas si quieres autorizar a más de una persona.
# WORKSPACE_DIR: carpeta base donde el bot ejecuta comandos.
# --------------------------------------------------------------------------
PERSONAL_BOT_TOKEN=
OWNER_CHAT_IDS=
WORKSPACE_DIR=/home/tu-usuario/proyectos
EXEC_TIMEOUT_MS=20000
EXEC_MAX_OUTPUT_CHARS=3500
COMMANDS_FILE=./commands.json

# Supabase (públicas, van en el bundle del cliente)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=https://app.nexorai.pamenagency.com

# --------------------------------------------------------------------------
# Todo lo de abajo NUNCA va en el bundle del cliente. Sólo se leen en
# Route Handlers / Server Components (lado servidor).
# --------------------------------------------------------------------------

# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Proveedor de IA para el resumen ejecutivo del audit (opcional; sin API key
# configurada cae automáticamente a la plantilla local, sin romper nada).
# AI_PROVIDER=groq             # mock | groq | anthropic | openai  (default: groq)
# GROQ_API_KEY=gsk_...         # gratis en https://console.groq.com/keys
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Stripe (no activo en el MVP; se deja preparado para cuando se conecten pagos reales)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_BUSINESS=price_...

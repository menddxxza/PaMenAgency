# Supabase (públicas, van en el bundle del cliente)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase (solo servidor, nunca en el cliente)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Places API (New) — https://console.cloud.google.com/apis/credentials
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Clasificación de calidad de web con IA (opcional, ENABLE_AI_QUALITY_CHECK=true la activa)
ENABLE_AI_QUALITY_CHECK=false
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
AI_PROVIDER=anthropic

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...

NEXT_PUBLIC_SITE_URL=http://localhost:3000

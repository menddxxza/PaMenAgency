# Notiq — variables de entorno.
# Copia este fichero a .env.local y rellena lo que necesites.

# --- Base de datos (Neon) ----------------------------------------------------
# Sin esta la app arranca, pero enseña un aviso de configuración en lugar de la
# aplicación. Connection string de tu proyecto en https://neon.tech (Dashboard →
# Connect). Aplica el esquema con:
#   psql "$DATABASE_URL" -f migrations/0001_neon.sql
DATABASE_URL=

# --- Autenticación (Auth.js) --------------------------------------------------
# Clave para firmar las sesiones. Genera una con:
#   npx auth secret
# o, sin el CLI de Auth.js:
#   openssl rand -base64 33
AUTH_SECRET=

# --- IA ---------------------------------------------------------------------
# Sin esta clave las funciones de IA devuelven 503 y el resto de la app funciona.
# Con un servidor local (ver OPENAI_BASE_URL abajo) puede ser cualquier texto no
# vacío: el servidor local normalmente no comprueba que sea una clave real.
OPENAI_API_KEY=
# Opcional. Por defecto gpt-4o-mini. Con un servidor local, el nombre del modelo
# que sirva ese servidor (ej. "llama3.1", "mistral"), no un modelo de OpenAI.
OPENAI_MODEL=
# Opcional. Por defecto la API de OpenAI. Para usar un servidor de IA en local en
# vez de OpenAI (casi todos exponen una API compatible en /v1/chat/completions):
#   Ollama:     http://localhost:11434/v1
#   LM Studio:  http://localhost:1234/v1
# No incluyas el "/chat/completions" final, se añade solo.
OPENAI_BASE_URL=

# --- Stripe -----------------------------------------------------------------
# Sin estas variables la app funciona entera, solo que nadie puede pasar de Free:
# los botones de contratación se sustituyen por un aviso.
# Empieza con las claves de test (sk_test_…) y no pases a live hasta haber probado
# el flujo completo con `stripe listen`.
STRIPE_SECRET_KEY=

# Signing secret del endpoint del webhook (whsec_…). Sin él, el webhook rechaza
# todo: es lo único que impide que cualquiera se regale el plan Team con un curl.
STRIPE_WEBHOOK_SECRET=

# Price IDs (price_…, NO los prod_…) de cada plan de pago.
# Estos son los de LIVE, ya creados en la cuenta. Solo funcionan con una sk_live_…:
# con una clave de test, Stripe responde «No such price». Para desarrollar, crea los
# mismos productos en modo test y pon aquí sus IDs.
STRIPE_PRICE_PRO=price_1U17pMA0ZutwmmcPlc4qgLvE
STRIPE_PRICE_TEAM=price_1U17pWA0ZutwmmcPAth6dFrK

# --- General ----------------------------------------------------------------
# URL canónica para metadatos y para las URLs de vuelta de Stripe Checkout.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Correos con plan Team gratis sin pasar por Stripe, separados por comas
# (ej. tucorreo@gmail.com,otro@dominio.com). Vacío por defecto: nadie tiene
# acceso especial hasta que se configure. Va aquí y no en el código para no
# dejar un correo real escrito en el historial de git.
ADMIN_EMAILS=

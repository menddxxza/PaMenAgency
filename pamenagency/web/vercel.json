{
  "rewrites": [
    {
      "source": "/facturas/",
      "destination": "https://pamenagency-facturas.vercel.app/"
    },
    {
      "source": "/facturas/:ruta*",
      "destination": "https://pamenagency-facturas.vercel.app/:ruta*"
    },
    {
      "source": "/asistente/",
      "destination": "https://pamenagency-facturas.vercel.app/asistente/"
    },
    {
      "source": "/asistente/:ruta*",
      "destination": "https://pamenagency-facturas.vercel.app/asistente/:ruta*"
    },
    {
      "source": "/incidencias/",
      "destination": "https://pamenagency-facturas.vercel.app/incidencias/"
    },
    {
      "source": "/incidencias/:ruta*",
      "destination": "https://pamenagency-facturas.vercel.app/incidencias/:ruta*"
    },
    {
      "source": "/((?!api/|facturas/|asistente/|incidencias/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/facturas",
      "destination": "/facturas/",
      "permanent": false
    },
    {
      "source": "/asistente",
      "destination": "/asistente/",
      "permanent": false
    },
    {
      "source": "/incidencias",
      "destination": "/incidencias/",
      "permanent": false
    },
    {
      "source": "/servicios/automatizacion",
      "destination": "/servicios/automatizacion-de-procesos",
      "permanent": true
    },
    {
      "source": "/servicios/integracion-de-ia",
      "destination": "/servicios/integracion-de-sistemas",
      "permanent": true
    },
    {
      "source": "/servicios/asistentes-de-ia",
      "destination": "/servicios/asistente-de-ia-empresarial",
      "permanent": true
    },
    {
      "source": "/servicios/ia-para-empresas",
      "destination": "/servicios/consultoria-de-ia",
      "permanent": true
    },
    {
      "source": "/servicios/ia-para-pymes",
      "destination": "/servicios/automatizacion-de-procesos",
      "permanent": true
    },
    {
      "source": "/servicios/ia-para-productividad",
      "destination": "/servicios/formacion",
      "permanent": true
    },
    {
      "source": "/servicios/estrategia-de-ia",
      "destination": "/servicios/consultoria-de-ia",
      "permanent": true
    },
    {
      "source": "/servicios/creacion-digital",
      "destination": "/servicios",
      "permanent": true
    }
  ]
}

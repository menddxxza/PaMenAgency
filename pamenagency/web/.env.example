# Endpoint opcional al que enviar el formulario de contacto por POST (JSON).
# Si no se define, el formulario compone un correo y abre el cliente del usuario.
VITE_CONTACT_ENDPOINT=

# Clave de la API de Claude, usada únicamente por la función serverless
# api/chat.ts (el asistente de IA). Sin prefijo VITE_: nunca debe llegar al
# navegador. En Vercel se configura en Settings -> Environment Variables.
ANTHROPIC_API_KEY=

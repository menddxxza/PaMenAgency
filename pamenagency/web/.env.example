# Endpoint opcional al que enviar el formulario de contacto por POST (JSON).
# Si no se define, el formulario compone un correo y abre el cliente del usuario.
VITE_CONTACT_ENDPOINT=

# Asistente de IA (api/chat.ts) — Groq (https://groq.com), inferencia alojada
# y muy rápida. Consigue la clave en https://console.groq.com/keys. En Vercel
# se configura en Settings -> Environment Variables (Production y Preview).
# Sin GROQ_API_KEY, el asistente responde igualmente con un mensaje que
# remite al contacto humano en vez de fallar.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Puntuación y respuesta automática de leads (api/lead.ts) — Resend
# (https://resend.com). Consigue la clave en https://resend.com/api-keys.
# Sin RESEND_API_KEY, esta función responde "no configurado" a propósito y
# ContactForm recurre a mailto: como hasta ahora — el lead nunca se pierde.
RESEND_API_KEY=
# IMPORTANTE: con el dominio de pruebas (onboarding@resend.dev) Resend solo
# entrega a la propia cuenta, no a un lead cualquiera. Para que los correos
# lleguen de verdad, verifica un dominio propio en Resend y pon aquí el
# remitente con ese dominio, p. ej. "PamenAgency <hola@pamenagency.com>".
RESEND_FROM=
# A qué email se avisa de cada lead nuevo (por defecto, el correo de
# contacto general de la agencia).
LEADS_EMAIL=
# Opcional: si se rellena, cada lead se reenvía también ahí en bruto — es el
# punto de enganche para Zapier / Make (Integromat) / HubSpot, lo que se
# elija. Requiere configurar esa cuenta por separado; esta variable solo
# apunta el envío, no crea la automatización.
ZAPIER_WEBHOOK_URL=

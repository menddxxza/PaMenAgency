# URL pública del sitio (para metadatos, sitemap y robots)
NEXT_PUBLIC_SITE_URL=https://iapyme.es

# Supabase — opcional. Sin esto la landing funciona igual y los apuntes
# de la lista de espera se registran en los logs del servidor.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Plausible — opcional. Si se deja vacío no se carga ningún script de analítica.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Clave pública de Supabase (navegador). Sin ella la web funciona pero sin catálogo.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Aviso por email al admin cuando algo entra en la cola de moderación.
# Opcional: sin esto, la moderación sigue funcionando igual, solo no llega el aviso.
RESEND_API_KEY=
ADMIN_EMAIL=

# Candado temporal de sitio completo (HTTP Basic Auth). Si se configura,
# TODA la web pide usuario/contraseña antes de servir nada. Déjala vacía
# para que el sitio sea público como siempre.
SITE_LOCK_PASSWORD=

# Asistente de compra con IA en el buscador de portada. Capa gratuita en
# console.groq.com. Sin esta clave, el botón "Pregúntale a la IA" sigue
# apareciendo pero responde que el asistente no está disponible.
GROQ_API_KEY=
